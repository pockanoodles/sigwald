# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# `next dev` writes here instead of /.next/ so a dev session can't clobber
# the production build that launchd serves (see next.config.js distDir).
/.next-dev/
# `npm run build:desktop` builds here, so it never replaces the served build.
/.next-desktop/
# Copied from src/lib/brand.ts by scripts/desktop/sync-brand.mjs.
/desktop/src/brand.ts
# `npm run dev:local`: its build directory, and its database and keys.
/.next-local/
/.local/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.test
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
prisma/dev.*

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/logs/
/blog/
diff.txt
data/*

/dist
scripts/test-outlook-task-api.sh

# Local working notes / build plans (kept local per code standards)
docs/v*-cleanup.md
docs/focus-mode.md
docs/weekly-checkin.md
docs/superpowers/
docs/SIGWALD-SPEC.md
docs/task-sync.md
docs/tasklist-enhancements.md
/TODO.md
/@TODO.md
/main-rule.mdc
/.cursor/

# Local runtime state and caches
*.db
*.sqlite
*.sqlite3
__pycache__/
.cache/

# Any other env file stays local, the example is the only one tracked
.env.*
!.env.example

# Server database copies (docker-compose backup service)
/backups/
